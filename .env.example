# =============================================================================
# RowingClub (CrewBase.be) - Ornek Ortam Degiskenleri Dosyasi
# =============================================================================
# Bu dosya sadece ORNEK amaclidir ve Git'e eklenebilir.
# Gercek degerleri asla bu dosyaya veya .env.developer / .env.product
# dosyalarina commit etmeyin. Bu dosyalar .gitignore icinde yer almalidir.
#
# Lokal gelistirme icin bu dosyayi kopyalayip ".env" veya ".env.developer"
# olarak kaydedin ve degerleri kendi ortaminiza gore doldurun:
#   cp .env.example .env
#
# Uretim (production) ortaminda degerler bu dosyadan degil; CI/CD secret
# store, Docker/Kubernetes secrets, Vault veya bulut secret manager
# uzerinden enjekte edilmelidir (bkz. spec bolum 10 - Secret Yonetimi).
# =============================================================================

# Uygulamanin calistigi ortam (Development, Staging, Production)
APP_ENV=

# MongoDB baglanti dizesi - platformun TEK veritabani (kullanici kimligi, kulup,
# uyelik, ders/randevu, paket, refresh token, outbox/inbox, bildirim, raporlama
# snapshot'lari ve audit detay dokumanlari icin - bkz. docs/DATA_MODEL.md).
# ZORUNLU: replicaSet parametresi icermelidir - MongoUnitOfWork coklu-dokuman
# transaction kullanir, standalone bir mongod bunu desteklemez (spec bolum 21).
# ornek: mongodb://mongodb:27017/rowingclub?replicaSet=rs0
MONGODB_CONNECTION_STRING=

# Kullanilacak MongoDB veritabani adi
MONGODB_DATABASE_NAME=rowingclub

# Redis baglanti dizesi (dagitik cache, idempotency, rate limiting, distributed lock)
REDIS_CONNECTION_STRING=

# JWT access/refresh token icin issuer (token'i yayinlayan otorite)
JWT_ISSUER=

# JWT access/refresh token icin audience (token'in hedef kitlesi)
JWT_AUDIENCE=

# JWT imzalama icin ozel anahtar (RS256/ES256 onerilir, PEM formatinda)
JWT_SIGNING_PRIVATE_KEY=

# JWT dogrulama icin genel anahtar (RS256/ES256 onerilir, PEM formatinda)
JWT_SIGNING_PUBLIC_KEY=

# Alan bazli sifreleme (AES-256-GCM) icin guncel/aktif anahtar
FIELD_ENCRYPTION_KEY_CURRENT=

# Alan bazli sifreleme icin bir onceki anahtar (key rotation sirasinda
# eski verilerin cozulebilmesi icin gereklidir)
FIELD_ENCRYPTION_KEY_PREVIOUS=

# Guncel alan sifreleme anahtarinin versiyon numarasi (key rotation takibi icin)
FIELD_ENCRYPTION_KEY_VERSION=

# E-posta gonderimi icin SMTP sunucu adresi
SMTP_HOST=

# SMTP kimlik dogrulama kullanici adi
SMTP_USERNAME=

# SMTP kimlik dogrulama parolasi
SMTP_PASSWORD=

# OpenTelemetry OTLP exporter endpoint adresi (trace/metric/log toplayicisi)
OTEL_EXPORTER_OTLP_ENDPOINT=

# Grafana admin kullanicisinin parolasi (lokal gelistirme dashboard erisimi)
GRAFANA_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Asagidaki degiskenler docker-compose.yml dosyasindaki servis
# port/parola parametrelerini kontrol etmek icin eklenmistir.
# -----------------------------------------------------------------------------

# RowingClub.Api container'inin disariya acacagi port (varsayilan: 8080)
API_HTTP_PORT=8080

# MongoDB container'inin disariya acacagi port (varsayilan: 27017)
MONGODB_PORT=27017

# Redis container'inin disariya acacagi port (varsayilan: 6379)
REDIS_PORT=6379

# Prometheus container'inin disariya acacagi port (varsayilan: 9090)
PROMETHEUS_PORT=9090

# Grafana container'inin disariya acacagi port (varsayilan: 3000)
GRAFANA_PORT=3000
