# =============================================================================
# RowingClub (CrewBase.be) - Production Ortam Degiskenleri Sablonu (.env.production)
# =============================================================================
# UYARI: Bu dosya BILINCLI OLARAK BOS birakilmistir ve gercek production
# sirlarini ASLA icermemelidir. .gitignore icinde yer alir; commit edilemez.
#
# Bu dosyayi dogrudan production'da `--env-file` olarak KULLANMAYIN. Amaci,
# production'in ihtiyac duydugu degiskenlerin TAM listesini dokumante etmektir.
# Gercek degerler CI/CD secret store, Docker/Kubernetes secrets, HashiCorp
# Vault veya bulut secret manager (AWS Secrets Manager, Azure Key Vault, GCP
# Secret Manager vb.) uzerinden, deploy zamaninda enjekte edilmelidir
# (bkz. spec bolum 10 - Secret Yonetimi, docs/DEPLOYMENT.md).
#
# Uygulama, asagidaki degiskenlerden herhangi biri eksikse baslangicta
# fail-fast olacak sekilde tasarlanmistir (JwtOptions/EncryptionOptions/
# MongoOptions ValidateOnStart) - eksik bir sir, sessizce yanlis davranan
# bir servis yerine acik bir baslangic hatasi uretir.
# =============================================================================

APP_ENV=Production

# --- PostgreSQL ---------------------------------------------------------------
# Backend, host/port/db-adindan baglanti dizesini kendisi olusturur (bkz.
# PostgresOptions.cs). Baslangicta EF Core migration'lari otomatik uygulanir.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE_NAME=rowingclub
POSTGRES_USERNAME=
POSTGRES_PASSWORD=

# --- Redis ------------------------------------------------------------------
# Production'da yonetilen bir Redis cluster/sentinel kullanin, TLS zorunlu.
REDIS_HOST=
REDIS_PORT=6379

# --- JWT (RS256 onerilir) ----------------------------------------------------
JWT_ISSUER=
JWT_AUDIENCE=
JWT_SIGNING_PRIVATE_KEY=
JWT_SIGNING_PUBLIC_KEY=

# --- Alan bazli sifreleme (AES-256-GCM) --------------------------------------
FIELD_ENCRYPTION_KEY_CURRENT=
FIELD_ENCRYPTION_KEY_PREVIOUS=
FIELD_ENCRYPTION_KEY_VERSION=

# --- SMTP ---------------------------------------------------------------------
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Observability ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=
